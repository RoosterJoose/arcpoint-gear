---
import ArticleCard from "./ArticleCard.astro";

const { articles = [], title = "Related Articles" } = Astro.props;
---

<section class="section related-section" data-reveal>
  <div class="section-heading">
    <p class="eyebrow">Next Reads</p>
    <h2>{title}</h2>
  </div>
  <div class="article-grid">
    {articles.slice(0, 3).map((article) => <ArticleCard article={article} compact />)}
  </div>
</section>
