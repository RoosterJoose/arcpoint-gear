---
import { categories } from "../data/categories";
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand-mark footer-brand" href="/">
        <span class="brand-dot"></span>
        ARCPOINT GEAR
      </a>
      <p>
        Premium gear intelligence for serious outdoor, athletic, tactical, and
        performance equipment decisions.
      </p>
    </div>
    <div>
      <h2>Categories</h2>
      <div class="footer-links">
        {categories.map((category) => <a href={`/category/${category.slug}`}>{category.name}</a>)}
      </div>
    </div>
    <div>
      <h2>Trust</h2>
      <div class="footer-links">
        <a href="/how-we-rate-gear">How We Rate Gear</a>
        <a href="/disclosure">Affiliate Disclosure</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 ArcPoint Gear.</span>
    <span>{site.email}</span>
  </div>
</footer>
