---
const { title = "ArcPoint Verdict", text, score } = Astro.props;
---

<section class="verdict-box" data-reveal>
  <div>
    <p class="eyebrow">{title}</p>
    <p>{text}</p>
  </div>
  {score && (
    <div class="verdict-score">
      <span>{score}</span>
      <small>Score</small>
    </div>
  )}
</section>
