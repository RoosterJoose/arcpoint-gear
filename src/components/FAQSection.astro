---
const { faqs = [] } = Astro.props;
---

<section class="content-block faq-section" data-reveal>
  <div class="faq-heading">
    <p class="eyebrow">Reader Notes</p>
    <h2>FAQ</h2>
  </div>
  {faqs.map((faq) => (
    <details>
      <summary>{faq.question}</summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</section>
