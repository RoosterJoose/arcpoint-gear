---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildBreadcrumbSchema } from "../utils/seo";

const jsonLd = [buildBreadcrumbSchema([{ label: "Privacy Policy", href: "/privacy" }])];
---

<Layout
  title="Privacy Policy | ArcPoint Gear"
  description="A simple professional privacy policy placeholder for ArcPoint Gear."
  canonical="/privacy"
  jsonLd={jsonLd}
>
  <main class="page-shell">
    <Breadcrumbs items={[{ label: "Privacy Policy" }]} />
    <section class="page-hero" data-reveal>
      <p class="eyebrow">Privacy</p>
      <h1>Privacy Policy</h1>
      <p>
        This placeholder policy describes the intended privacy posture for ArcPoint Gear during
        the front-end foundation phase.
      </p>
    </section>
    <section class="content-block" data-reveal>
      <h2>Information Collection</h2>
      <p>
        This static site does not currently provide user accounts, comments, purchases, or a working
        contact form. Basic hosting analytics may be added later and should be disclosed here.
      </p>
      <h2>Affiliate Links</h2>
      <p>
        Affiliate links may send you to third-party retailers. Those retailers operate under their
        own privacy policies.
      </p>
      <h2>Future Updates</h2>
      <p>
        This page should be reviewed before adding analytics, email capture, accounts, backend
        integrations, or advertising tools.
      </p>
    </section>
  </main>
</Layout>
