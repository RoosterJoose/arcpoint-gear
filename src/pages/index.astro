---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import FeaturedReport from "../components/FeaturedReport.astro";
import TrustPanel from "../components/TrustPanel.astro";
import DisclosureNote from "../components/DisclosureNote.astro";
import { categories } from "../data/categories";
import { latestArticles } from "../data/articles";
---

<Layout
  title="ArcPoint Gear | Premium Gear Intelligence"
  description="Premium gear intelligence for serious outdoor, athletic, photography, golf, fishing, hunting, camping, and performance equipment."
>
  <main>
    <section class="hero-section">
      <div class="hero-copy-wrap" data-reveal>
        <p class="eyebrow">ArcPoint Gear</p>
        <h1>Built For The Extremes.</h1>
        <p class="hero-copy">
          ArcPoint Gear is a premium gear intelligence publication for serious outdoor,
          athletic, photography, golf, fishing, hunting, camping, and performance equipment.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="#latest">Latest Reports</a>
          <a class="button button-secondary" href="/how-we-rate-gear">How We Rate Gear</a>
        </div>
        <div class="hero-stats" aria-label="ArcPoint Gear editorial focus">
          <span><strong>8</strong> Gear Verticals</span>
          <span><strong>4</strong> Review Labels</span>
          <span><strong>0</strong> Fake Field Claims</span>
        </div>
      </div>
      <div class="hero-panel" data-reveal>
        <div class="hero-visual">
          <span>Product Lab / Field Notes / Spec Index</span>
        </div>
        <FeaturedReport article={latestArticles[0]} />
      </div>
    </section>

    <section class="section" id="latest" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">Latest Reports</p>
        <h2>Research-led gear calls for high-consequence kit decisions.</h2>
        <p>
          Every report is labeled by method so readers can separate research reviews, spec
          analysis, comparisons, and buying advice at a glance.
        </p>
      </div>
      <div class="article-grid">
        {latestArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>

    <section class="section" id="categories" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">Gear Categories</p>
        <h2>Eight focused verticals, one technical editorial standard.</h2>
        <p>
          Built for readers comparing real equipment tradeoffs: fit, durability, weather
          resistance, weight, materials, value, and use-case match.
        </p>
      </div>
      <div class="category-grid">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </section>

    <TrustPanel />
    <DisclosureNote />
  </main>
</Layout>
