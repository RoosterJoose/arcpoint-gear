---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import FAQSection from "../../components/FAQSection.astro";
import DisclosureNote from "../../components/DisclosureNote.astro";
import { comparisonArticles } from "../../data/articleContent";
import { buildArticleSchema, buildBreadcrumbSchema, buildFAQSchema } from "../../utils/seo";

const article = comparisonArticles["osprey-talon-22-vs-deuter-speed-lite"];
const { title, description, canonical, faqs } = article;

const breadcrumbs = [
  { label: "Compare" },
  { label: "Osprey Talon 22 vs Deuter Speed Lite", href: canonical },
];

const jsonLd = [
  buildBreadcrumbSchema(breadcrumbs),
  buildArticleSchema({
    title,
    description,
    canonical,
    type: "Article",
    section: article.category,
    keywords: article.keywords,
  }),
  buildFAQSchema(faqs),
];
---

<Layout
  title={`${title} | ArcPoint Gear`}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <main class="article-shell">
    <Breadcrumbs items={[{ label: "Compare" }, { label: "Osprey Talon 22 vs Deuter Speed Lite" }]} />
    <header class="article-hero" data-reveal>
      <div class="badge-row">
        <span class="badge badge-category">{article.category}</span>
        <span class="badge badge-type">{article.typeLabel}</span>
      </div>
      <h1>{title}</h1>
      <p>
        A specification-led comparison for hikers choosing between structured mountain utility
        and a lighter fast-hiking profile.
      </p>
      <div class="article-meta">
        <span>By ArcPoint Gear Editorial</span>
        <span>{article.date}</span>
        <span>{article.readTime}</span>
      </div>
      <div class="article-visual article-visual-compare"><span>{article.heroLabel}</span></div>
    </header>
    <DisclosureNote />
    <ComparisonTable rows={article.tableRows} title="Head-to-Head Comparison" />
    <section class="winner-grid" data-reveal>
      {article.winners.map((winner) => (
        <div>
          <span>{winner.label}</span>
          <h2>{winner.title}</h2>
          <p>{winner.text}</p>
        </div>
      ))}
    </section>
    <section class="content-block" data-reveal>
      {article.sections.map((section) => (
        <>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
        </>
      ))}
    </section>
    <FAQSection faqs={faqs} />
  </main>
</Layout>
