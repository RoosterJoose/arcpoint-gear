---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import ArticleTypeBadge from "../../components/ArticleTypeBadge.astro";
import DisclosureNote from "../../components/DisclosureNote.astro";
import ProductSummaryCard from "../../components/ProductSummaryCard.astro";
import SpecTable from "../../components/SpecTable.astro";
import ProsCons from "../../components/ProsCons.astro";
import VerdictBox from "../../components/VerdictBox.astro";
import FAQSection from "../../components/FAQSection.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import AffiliateButton from "../../components/AffiliateButton.astro";
import { relatedArticles } from "../../data/articles";
import { reviewArticles } from "../../data/articleContent";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
  buildReviewSchema,
} from "../../utils/seo";

const article = reviewArticles["osprey-talon-22-review"];
const { title, description, canonical, faqs, product } = article;

const breadcrumbs = [
  { label: article.category, href: `/category/${article.categorySlug}` },
  { label: title, href: canonical },
];

const jsonLd = [
  buildBreadcrumbSchema(breadcrumbs),
  buildArticleSchema({
    title,
    description,
    canonical,
    type: "Article",
    section: article.category,
    keywords: article.keywords,
  }),
  buildReviewSchema({
    product,
    canonical,
    title,
    reviewBody:
      "Research Review based on product specifications, category comparison, and owner feedback themes. ArcPoint Gear does not claim hands-on field testing for this review.",
  }),
  buildFAQSchema(faqs),
];
---

<Layout
  title={`${title} | ArcPoint Gear`}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
>
  <main class="article-shell">
    <Breadcrumbs items={[{ label: article.category, href: `/category/${article.categorySlug}` }, { label: title }]} />
    <header class="article-hero" data-reveal>
      <div class="badge-row">
        <CategoryBadge label={article.category} href={`/category/${article.categorySlug}`} />
        <ArticleTypeBadge label={article.typeLabel} />
      </div>
      <h1>{title}</h1>
      <p>
        Based on product specifications, category comparison, and owner feedback, this research
        review evaluates where the Talon 22 still looks strongest and where lighter alternatives
        may make more sense.
      </p>
      <div class="article-meta">
        <span>By ArcPoint Gear Editorial</span>
        <span>{article.date}</span>
        <span>{article.readTime}</span>
      </div>
      <div class="article-visual article-visual-review">
        <span>{article.heroLabel}</span>
      </div>
    </header>

    <DisclosureNote />

    <div class="article-layout">
      <aside class="toc">
        <a href="#summary">Summary</a>
        <a href="#buy-skip">Buy / Skip</a>
        <a href="#specs">Specs</a>
        <a href="#verdict">Verdict</a>
      </aside>
      <article class="article-content">
        <section id="summary" class="content-block" data-reveal>
          <ProductSummaryCard product={product} />
        </section>

        <section id="buy-skip" class="two-column-content" data-reveal>
          <div>
            <h2>Who Should Buy</h2>
            <p>{article.buySkip.buy}</p>
          </div>
          <div>
            <h2>Who Should Skip</h2>
            <p>{article.buySkip.skip}</p>
          </div>
        </section>

        <SpecTable rows={product.specs} title="Key Specifications" />

        <section class="content-block" data-reveal>
          <h2>Main Analysis</h2>
          {article.analysis.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <ProsCons pros={product.pros} cons={product.cons} />
        <div id="verdict">
          <VerdictBox
            score={product.score}
            text={article.verdict}
          />
        </div>
        <section class="cta-panel" data-reveal>
          <div>
            <p class="eyebrow">Retailer Check</p>
            <h2>Check current retailer availability</h2>
            <p>Price tier: {article.cta.priceTier}. {article.cta.disclosure}</p>
          </div>
          <AffiliateButton href={article.cta.href} label={article.cta.label} />
        </section>
        <FAQSection faqs={faqs} />
      </article>
    </div>
    <RelatedArticles articles={relatedArticles} />
  </main>
</Layout>
