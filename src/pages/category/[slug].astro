---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories } from "../../data/categories";
import { articles } from "../../data/articles";
import { buildBreadcrumbSchema } from "../../utils/seo";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const matchedArticles = articles.filter((article) => article.categorySlug === category.slug);
const fallbackArticles = articles.slice(0, 3);
const pageArticles = matchedArticles.length ? matchedArticles : fallbackArticles;
const articleCountClass = `category-article-grid count-${Math.min(pageArticles.length, 3)}`;
const canonical = `/category/${category.slug}`;
const categoryTitle = category.name.endsWith("Gear") ? category.name : `${category.name} Gear`;
const categoryEyebrow =
  category.slug === "performance-gear"
    ? "Technical apparel, shells, insulation, wearables, and high-output systems."
    : category.accent;
const jsonLd = [buildBreadcrumbSchema([{ label: category.name, href: canonical }])];
---

<Layout
  title={`${categoryTitle} | ArcPoint Gear`}
  description={category.description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <main class="page-shell category-page">
    <div class="category-breadcrumbs">
      <Breadcrumbs items={[{ label: category.name }]} />
    </div>
    <section class="page-hero category-hero" data-reveal>
      <p class="eyebrow">{categoryEyebrow}</p>
      <h1>{categoryTitle}</h1>
      <p>{category.description}</p>
      <div class="hero-stats category-stats" aria-label={`${category.name} coverage focus`}>
        <span><strong>Focus</strong> {category.focus}</span>
        <span><strong>Method</strong> Research-led</span>
        <span><strong>Pricing</strong> Tier only</span>
      </div>
    </section>

    <section class="category-reports" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">Category Desk</p>
        <h2>Reports and shortlists for {categoryTitle.toLowerCase()}.</h2>
        <p>
          Research reviews, spec analysis, and buying guidance are organized around practical
          use cases, not hype cycles.
        </p>
      </div>
      <div class={articleCountClass}>
        {pageArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>

    <section class="content-block category-note" data-reveal>
      <div>
        <p class="eyebrow">Editorial Queue</p>
        <h2>Coming Research</h2>
      </div>
      <div>
        <p>
          This category will expand with research reviews, spec analysis, buying guides, and
          comparison reports. Early coverage focuses on products where fit, durability, weather
          resistance, and value meaningfully change the buying decision.
        </p>
        <p>
          Placeholder report cards are intentionally labeled as previews or category links until a
          full editorial page exists. ArcPoint Gear does not present research queues as field-tested
          reviews.
        </p>
      </div>
    </section>
  </main>
</Layout>
