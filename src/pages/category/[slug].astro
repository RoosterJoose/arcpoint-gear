---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories } from "../../data/categories";
import { articles } from "../../data/articles";

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const matchedArticles = articles.filter((article) => article.categorySlug === category.slug);
const fallbackArticles = articles.slice(0, 3);
const pageArticles = matchedArticles.length ? matchedArticles : fallbackArticles;
---

<Layout
  title={`${category.name} Gear | ArcPoint Gear`}
  description={category.description}
  canonical={`/category/${category.slug}`}
>
  <main class="page-shell">
    <Breadcrumbs items={[{ label: category.name }]} />
    <section class="page-hero" data-reveal>
      <p class="eyebrow">{category.accent}</p>
      <h1>{category.name} Gear</h1>
      <p>{category.description}</p>
    </section>

    <section class="section" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">Category Desk</p>
        <h2>Reports and shortlists for {category.name.toLowerCase()} equipment.</h2>
      </div>
      <div class="article-grid">
        {pageArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </section>

    <section class="content-block" data-reveal>
      <h2>Coming Research</h2>
      <p>
        This category will expand with research reviews, spec analysis, buying guides, and
        comparison reports. Early coverage focuses on products where fit, durability, weather
        resistance, and value meaningfully change the buying decision.
      </p>
    </section>
  </main>
</Layout>
